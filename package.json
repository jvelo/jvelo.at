{
  "name": "jvelo.at",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.x"
  },
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "wrangler dev src/index.tsx",
    "dev:node": "tsx watch src/server.tsx",
    "dev:content": "tsx watch --clear-screen=false --include 'content/**' --include 'resume/resume.yaml' scripts/bundle-content.ts",
    "prebuild": "tsx scripts/bundle-content.ts",
    "build": "tsc",
    "resume": "typst compile --root . resume/resume.typ public/Jerome_Velociter_Product_Engineer_Tech_Lead_2026.pdf",
    "predeploy": "tsx scripts/bundle-content.ts && pnpm run resume",
    "deploy": "wrangler deploy",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@jvelo/tapemark-d1": "^0.9.0",
    "@jvelo/tapemark-hono": "^0.9.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.0.0",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.48.0"
  }
}
